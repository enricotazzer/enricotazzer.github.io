{%- comment -%}
  Atom feed of the posts in the page's language. Rendered by feed.xml,
  en/feed.xml and nl/feed.xml. Entry ids match the ones jekyll-feed used, so
  existing subscribers of /feed.xml see no duplicates.
{%- endcomment -%}
{%- assign t = site.data.i18n[page.lang] -%}
{%- assign feed_posts = site.posts | where: "lang", page.lang -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ page.lang }}">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ t.description | xml_escape }}</subtitle>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ t.prefix | append: '/' | absolute_url }}" rel="alternate" type="text/html" hreflang="{{ page.lang }}"/>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author | xml_escape }}</name></author>
  {%- for post in feed_posts limit: 20 %}
  <entry>
    <title type="html">{{ post.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}"/>
    <id>{{ post.id | absolute_url | xml_escape }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <author><name>{{ site.author | xml_escape }}</name></author>
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}"/>
    {%- endfor %}
    {%- if post.subtitle %}
    <summary type="html">{{ post.subtitle | strip_html | normalize_whitespace | xml_escape }}</summary>
    {%- endif %}
    <content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}">{{ post.content | strip | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
